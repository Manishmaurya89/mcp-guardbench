# MCP-GuardBench configuration. Copy to `.env` and adjust.
# Every value below is a LOCAL LAB default. Nothing here is a real credential.
# The only "secrets" in this project are the synthetic markers
# (TEST_SECRET_123, TEST_PRIVATE_RECORD, SIMULATED_EXTERNAL_DESTINATION).

# --- Runtime mode -----------------------------------------------------------
# true  = simplified local setup: API-key check disabled, tables auto-created.
# false = API requires GUARDBENCH_API_KEY on every non-health request.
GUARDBENCH_DEV_MODE=true
GUARDBENCH_LOG_LEVEL=INFO
GUARDBENCH_LOG_JSON=true

# --- Database ---------------------------------------------------------------
# Local default is SQLite. docker-compose overrides this with PostgreSQL.
GUARDBENCH_DATABASE_URL=sqlite:///./data/guardbench.db

# PostgreSQL container credentials (docker-compose only). Change for anything
# beyond a throwaway local lab.
POSTGRES_DB=guardbench
POSTGRES_USER=guardbench
POSTGRES_PASSWORD=change-me-local-lab-only

# --- API --------------------------------------------------------------------
GUARDBENCH_API_HOST=127.0.0.1
GUARDBENCH_API_PORT=8000
# Required when GUARDBENCH_DEV_MODE=false. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GUARDBENCH_API_KEY=

# --- Dashboard --------------------------------------------------------------
GUARDBENCH_API_URL=http://127.0.0.1:8000
GUARDBENCH_DASHBOARD_PORT=8501

# --- Lab safety limits ------------------------------------------------------
# Allowlisted directories. Test cases and fixtures outside these are rejected.
GUARDBENCH_TEST_CASES_DIR=test_cases
GUARDBENCH_REPORTS_DIR=reports
# Bounded model-context size for tool responses (bytes).
GUARDBENCH_MAX_RESPONSE_BYTES=4096
# Maximum tool calls allowed per trace (runaway-loop guard).
GUARDBENCH_MAX_CALLS_PER_TRACE=10
